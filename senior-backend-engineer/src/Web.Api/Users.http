@HostAddress = http://localhost:5229
@ExistingUserId = replace-with-id-returned-by-create
@MissingUserId = 00000000-0000-0000-0000-000000000000

### Create a user (201 Created)
POST {{HostAddress}}/users
Content-Type: application/json

{
  "username": "alice"
}

### Create the same user again (409 Conflict)
POST {{HostAddress}}/users
Content-Type: application/json

{
  "username": "ALICE"
}

### Create a user with a blank username (400 Bad Request)
POST {{HostAddress}}/users
Content-Type: application/json

{
  "username": "   "
}

### Retrieve the created user (200 OK)
# Replace ExistingUserId above with the ID returned by the first request.
GET {{HostAddress}}/users/{{ExistingUserId}}
Accept: application/json

### Retrieve a missing user (404 Not Found)
GET {{HostAddress}}/users/{{MissingUserId}}
Accept: application/json
